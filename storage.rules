rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can only access and upload files in their own folder partition
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Disallow all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
