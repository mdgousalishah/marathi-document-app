rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secure user-scoped documents: Users can only read and write their own documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /documents/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /files/{fileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Disallow all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
